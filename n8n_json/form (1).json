    {
      "parameters": {
        "jsCode": "const incomingItems = $input.all();\nconst results = [];\n\nfor (let item of incomingItems) {\n  // Safe payload extraction\n  const rawData = item.json.body?.donorData || item.json.donorData || item.json;\n\n  // Sanitize and Clean Name (Capitalize first letters)\n  const cleanName = rawData.name \n    ? rawData.name.trim().split(' ').map(w => w.charAt(0).toUpperCase() + w.slice(1).toLowerCase()).join(' ')\n    : 'Anonymous Donor';\n\n  // Sanitize and Clean Mobile Number to international format\n  let cleanMobile = rawData.mobile ? rawData.mobile.replace(/[^0-9]/g, '') : '';\n  if (cleanMobile.startsWith('03')) {\n    cleanMobile = '92' + cleanMobile.slice(1);\n  }\n\n  // Construct the output structure safely\n  results.push({\n    json: {\n      name: cleanName,\n      mobile: cleanMobile,\n      bloodGroup: rawData.bloodGroup ? rawData.bloodGroup.toUpperCase().trim() : 'O+',\n      age: parseInt(rawData.age) || 26,\n      address: rawData.address ? rawData.address.trim() : 'Nankana Sahib',\n      medicalHistory: rawData.medicalHistory ? rawData.medicalHistory.trim() : 'None',\n      registrationDate: new Date().toLocaleDateString('en-PK', { timeZone: 'Asia/Karachi' })\n    }\n  });\n}\n\nreturn results;"
      },
